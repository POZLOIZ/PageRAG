# 复制为 .env 后逐项填写。.env 不会进入版本库。
# MySQL 8，驱动固定为 asyncmy。需要先创建数据库和账号。
PAGERAG_DATABASE_URL=mysql+asyncmy://user:password@127.0.0.1:3306/pagerag

# Milvus 2.6。本地单机可以不填 token。
PAGERAG_MILVUS_URI=http://127.0.0.1:19530
PAGERAG_MILVUS_TOKEN=

# 生成模型，要求 OpenAI 兼容的 /v1/chat/completions。
# llm_api_key 必填；llm_base_url 和 llm_model 为空时服务无法启动。
PAGERAG_LLM_BASE_URL=https://api.example.com/v1
PAGERAG_LLM_MODEL=your-chat-model
PAGERAG_LLM_API_KEY=

# 可选备援通道。主通道不可用时才使用；三项都留空表示不启用。
# PAGERAG_LLM_PRIMARY_BASE_URL=
# PAGERAG_LLM_PRIMARY_MODEL=
# PAGERAG_LLM_PRIMARY_API_KEY=

# 嵌入服务，要求 OpenAI 兼容的 POST /v1/embeddings，请求含 model、input、
# input_type 和 dimensions，返回 {"data": [{"embedding": [...]}]}。
# 向量维度必须与 dimensions 一致；换模型或维度后必须重建索引。
PAGERAG_EMBEDDING_BASE_URL=http://127.0.0.1:8080/v1
PAGERAG_EMBEDDING_MODEL=your-embedding-model
PAGERAG_EMBEDDING_API_KEY=unused
PAGERAG_EMBEDDING_DIMENSIONS=1024

# 重排服务，要求 POST /rerank，请求含 model、query、documents 和 top_n，
# 返回 {"results": [{"index": 0, "relevance_score": 0.9}]}。
# 默认检索策略 hybrid-rerank 需要这一项；只用 dense 时可以留空。
PAGERAG_RERANK_URL=http://127.0.0.1:8080/rerank
PAGERAG_RERANK_MODEL=your-reranker-model
PAGERAG_RERANK_API_KEY=

# 检索策略：hybrid-rerank 为向量与关键词混合召回后重排；
# dense 为纯向量对照；hybrid-rrf 为不重排的融合对照。
# PAGERAG_RETRIEVAL_STRATEGY=hybrid-rerank
# PAGERAG_RETRIEVAL_TOP_K=30
# PAGERAG_RERANK_POOL_SIZE=60

# 证据组装：最终送入上下文的证据单元上限、token 预算和单篇文档配额。
# window 模式会把命中块前后各补一块；neighbor-rerank 是旧对照。
# PAGERAG_EVIDENCE_UNIT_LIMIT=20
# PAGERAG_CONTEXT_TOKEN_BUDGET=6000
# PAGERAG_EVIDENCE_CONTEXT_MODE=window
# PAGERAG_EVIDENCE_DOCUMENT_LIMIT=3

# 分块：500 是合并相邻完整段落的软目标，3000 是无结构长文的硬上限。
# PAGERAG_CHUNK_CHARS=500
# PAGERAG_CHUNK_MAX_CHARS=3000

# 引用核验：生成后检查每条结论是否有引用、引用是否支持结论。
# PAGERAG_ANSWER_VERIFICATION_ENABLED=true

# 多用户登录：默认关闭。开启后集合与对话按创建者隔离。
# PAGERAG_AUTH_ENABLED=false
